---
import { author, flutterPackages, hero, site } from '@/config.json'

const [github, x] = hero.socials
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="author" content={author.name} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.url} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href={site.favicon} />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
    <title>{site.title}</title>
  </head>
  <body>
    <header class="site-nav" data-site-nav>
      <div class="site-nav__inner">
        <a class="wordmark" href="/" aria-label="LEEWEI0923 首页">
          <span class="wordmark__text">LEEWEI0923</span>
          <span class="wordmark__dot" aria-hidden="true"></span>
        </a>
        <nav class="site-nav__menu" aria-label="主导航">
          <a class="site-nav__link is-active" href="/" aria-current="page">Home</a>
          <a class="site-nav__link" href="/blog">Blog</a>
          <a class="site-nav__link" href="/projects">Projects</a>
        </nav>
        <span class="site-nav__spacer" aria-hidden="true"></span>
      </div>
    </header>

    <main>
      <article aria-labelledby="intro-title" data-language-content>
        <h1 id="intro-title">{hero.name}</h1>

        <div class="content">
          <p class="lead">
            <span data-copy="zh">你好，我是 {hero.name}，一名独立开发者与 AI 创业者。</span>
            <span data-copy="en"
              >Hi, I'm {hero.name}, an independent developer and AI entrepreneur.</span
            >
          </p>

          <div class="now" data-now aria-label="目前正在进行的事情">
            <p>
              <span data-copy="zh">正在做 <span class="tag">拾记</span></span>
              <span data-copy="en">Currently building <span class="tag">Shiji</span></span>
            </p>
            <p>
              <span data-copy="zh">一个只属于你的记录系统。</span>
              <span data-copy="en">A personal system for capturing what matters to you.</span>
            </p>
          </div>

          <p>
            <span data-copy="zh">
              我也在开发 Flutter
              插件，把日常开发中反复遇到的小问题整理成更轻量、好用的工具，希望能让构建跨平台应用的过程更顺手一些。
            </span>
            <span data-copy="en">
              I also build Flutter plugins, turning recurring problems from day-to-day development
              into lightweight, practical tools that make building cross-platform apps feel a little
              smoother.
            </span>
          </p>

          <p>
            <span data-copy="zh">
              我喜欢把零散的想法做成真正能用的产品，从设计界面到完成开发，让想法落地是一件很有意思的事情。你可以在这里查看我的<a
                href="/projects">项目列表</a
              >。
            </span>
            <span data-copy="en">
              I enjoy turning scattered ideas into products people can actually use, from shaping
              the interface to shipping the final experience. You can explore my <a href="/projects"
                >project list</a
              > here.
            </span>
          </p>

          <p>
            <span data-copy="zh">
              我也会写一些关于产品、技术和生活的文字。偶尔记录灵光乍现，也收藏那些仍在发生的日常。你可以从<a
                href="/blog">博客</a
              >开始阅读。
            </span>
            <span data-copy="en">
              I also write about products, technology, and life—capturing passing ideas and the
              everyday moments still unfolding. You can start with my <a href="/blog">blog</a>.
            </span>
          </p>
        </div>

        <section class="packages" aria-labelledby="packages-title">
          <header class="packages__header">
            <p class="packages__eyebrow">{flutterPackages.eyebrow}</p>
            <h2 id="packages-title">{flutterPackages.title}</h2>
          </header>

          <ul class="packages__grid">
            {
              flutterPackages.items.map((item) => (
                <li class="package-item">
                  <a
                    class="package-card"
                    href={item.link || undefined}
                    target={item.link ? '_blank' : undefined}
                    rel={item.link ? 'noopener noreferrer external' : undefined}
                  >
                    <span class="package-card__step">STEP {item.step}</span>

                    <span class="package-card__icon" aria-hidden="true">
                      {item.icon === 'display' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 144 104"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--magenta"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M30 28h78v42H30z" />
                            <path d="M38 82h62" />
                            <path d="M52 82v-7h34v7" />
                            <path d="M45 18l13 10M99 18l-13 10" />
                          </g>
                          <g class="pixel pixel--magenta">
                            <path d="M46 40h30v7H46z" opacity=".28" />
                            <path d="M116 36h7v7h-7zM116 49h7v7h-7zM116 62h7v7h-7zM102 62h7v7h-7z" />
                          </g>
                        </svg>
                      )}

                      {item.icon === 'workflow' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 150 118"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--orange"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M22 20h34v8h8v28h-8v8H22v-8h-8V28h8z" />
                            <path d="M64 42h16V28h8" />
                            <path d="M64 54h16v32h8" />
                            <path d="M92 20h34v8h8v28h-8v8H92v-8h-8V28h8z" />
                            <path d="M92 72h34v8h8v24h-8v8H92v-8h-8V80h8z" />
                          </g>
                        </svg>
                      )}

                      {item.icon === 'notes' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 150 112"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--magenta"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M20 38h58v42H40l-12 12V80H20z" />
                            <path d="M34 52h28M34 64h20" />
                          </g>
                          <g
                            class="pixel pixel--orange"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M70 22h56v40H98l-12 12V62H70z" />
                            <path d="M84 36h28M84 48h20" />
                            <path d="M112 10h18v8h-8v8h-8v-8h-8v-8z" fill="currentColor" />
                          </g>
                        </svg>
                      )}
                    </span>

                    <div class="package-card__body">
                      <h3 class="package-card__title">{item.title}</h3>
                      <p class="package-card__description">{item.description}</p>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="divider" aria-hidden="true"></div>

        <footer>
          <p>
            <span data-copy="zh">在其他地方找到我</span>
            <span data-copy="en">Find me elsewhere</span>
          </p>
          <nav data-socials aria-label="社交媒体">
            {
              github && (
                <a href={github.url} rel="me noreferrer">
                  GitHub
                </a>
              )
            }
            {
              x && (
                <a href={x.url} rel="me noreferrer">
                  X / Twitter
                </a>
              )
            }
          </nav>
        </footer>
      </article>
    </main>

    <script is:inline>
      const siteNav = document.querySelector('[data-site-nav]')
      const updateNav = () => {
        siteNav?.toggleAttribute('data-scrolled', window.scrollY > 16)
      }

      let isFramePending = false
      const handleScroll = () => {
        if (isFramePending) return
        isFramePending = true
        requestAnimationFrame(() => {
          isFramePending = false
          updateNav()
        })
      }

      updateNav()
      window.addEventListener('scroll', handleScroll, { passive: true })
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-bold.woff') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    font-family: 'Atkinson', 'PingFang SC', 'Microsoft YaHei', ui-sans-serif, system-ui, sans-serif;
    color: #242424;
    background-color: #fbfbfa;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    background-image: radial-gradient(circle, rgb(35 35 35 / 11%) 1px, transparent 1.2px);
    background-size: 24px 24px;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  main {
    position: relative;
    width: min(100% - 3rem, 54rem);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) 0 4rem;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100% - 2.5rem, 1100px);
    min-height: 64px;
    margin: 0 auto;
    border-bottom: 1px solid transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-nav[data-scrolled] .site-nav__inner {
    border-bottom-color: rgb(35 35 35 / 10%);
    background-color: rgb(251 251 250 / 78%);
    backdrop-filter: blur(12px) saturate(150%);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    justify-self: start;
    color: #111;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: #111;
    text-decoration: none;
  }

  .wordmark__dot {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.06em;
    border-radius: 50%;
    background: #f55555;
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    column-gap: 2rem;
    justify-self: center;
  }

  .site-nav__link {
    position: relative;
    padding-bottom: 2px;
    color: #5d5d5d;
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .site-nav__link:hover {
    color: #111;
    text-decoration: none;
  }

  .site-nav__link.is-active {
    color: #111;
  }

  .site-nav__link.is-active::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: #111;
    content: '';
  }

  .site-nav__spacer {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .site-nav__inner {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
      padding: 0.75rem 0 0.7rem;
    }

    .site-nav__spacer {
      display: none;
    }

    .wordmark {
      justify-self: start;
      font-size: 0.95rem;
    }

    .site-nav__menu {
      justify-self: center;
      column-gap: 1.25rem;
    }
  }

  [data-copy='en'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='zh'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='en'] {
    display: inline;
  }

  article {
    width: 100%;
  }

  h1 {
    margin: 0;
    color: #111;
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .content {
    margin-top: clamp(3rem, 7vw, 4.25rem);
    color: #5d5d5d;
    font-size: clamp(1.2rem, 2.8vw, 1.45rem);
    line-height: 1.82;
  }

  html[data-lang='zh'] .content {
    font-size: clamp(1.12rem, 2.6vw, 1.34rem);
    line-height: 1.78;
  }

  .content p {
    margin: 0 0 1.55rem;
  }

  .content .lead {
    margin-bottom: 2rem;
  }

  .now {
    margin-bottom: 2.25rem;
  }

  .now p {
    margin: 0.15rem 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    margin-left: 0.25rem;
    padding: 0.05em 0.45em;
    border-radius: 0.35rem;
    color: #666;
    background: #ededeb;
    font-size: 0.92em;
  }

  a {
    color: #171717;
    text-decoration-color: #a9a9a6;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  a:hover {
    color: #000;
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 2px solid #3467d6;
    outline-offset: 4px;
  }

  .divider {
    width: 4rem;
    height: 1px;
    margin: 3.75rem auto 2.75rem;
    background: #d9d9d6;
  }

  footer {
    color: #5d5d5d;
    font-size: 1.18rem;
  }

  html[data-lang='zh'] footer {
    font-size: 1.1rem;
  }

  footer > p {
    margin: 0 0 1rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
  }

  nav a {
    color: #262626;
  }

  .packages {
    margin-top: clamp(4.75rem, 10vw, 7.5rem);
  }

  .packages__header {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .packages__eyebrow {
    margin: 0;
    color: #888884;
    font-size: 0.72rem;
    line-height: 1.2;
    letter-spacing: 0.14em;
  }

  .packages__title {
    margin: 0.85rem 0 0;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 6.4vw, 3.65rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.035em;
  }

  .packages__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .package-item {
    min-width: 0;
  }

  .package-card {
    display: flex;
    min-height: clamp(24rem, 37vw, 29rem);
    flex-direction: column;
    align-items: center;
    padding: clamp(1.35rem, 2.8vw, 2rem);
    border: 1px solid #ececea;
    border-radius: 1.4rem;
    color: #242424;
    background: #f7f7f6;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  a.package-card[href]:hover {
    border-color: #d6d6d2;
    background: #f4f4f2;
    box-shadow: 0 12px 30px rgb(20 20 18 / 7%);
    transform: translateY(-4px);
  }

  .package-card:focus-visible {
    outline: 2px solid #3467d6;
    outline-offset: 4px;
  }

  .package-card__step {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(35 35 35 / 3%);
    border-radius: 0.5rem;
    color: #666662;
    background: #fff;
    box-shadow: 0 1px 2px rgb(20 20 18 / 4%);
    font-size: 0.73rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .package-card__icon {
    --pixel-magenta: #f22bcf;
    --pixel-orange: #f4511e;
    display: grid;
    width: 100%;
    min-height: 9rem;
    flex: 1;
    place-items: center;
    padding: 2.75rem 1rem 2.5rem;
  }

  .package-icon {
    width: min(100%, 7.75rem);
    height: auto;
    overflow: visible;
  }

  .pixel--magenta {
    fill: var(--pixel-magenta);
    stroke: var(--pixel-magenta);
  }

  .pixel--orange {
    fill: var(--pixel-orange);
    stroke: var(--pixel-orange);
  }

  .package-card__body {
    display: block;
    margin-top: auto;
  }

  .package-card__title {
    margin: 0;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.35rem, 2.7vw, 1.72rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .package-card__description {
    max-width: 20rem;
    margin: 0.85rem auto 0;
    color: #777773;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .packages__grid {
      max-width: 32rem;
      grid-template-columns: 1fr;
      margin-inline: auto;
    }

    .package-card {
      min-height: 22rem;
    }

    .package-card__icon {
      min-height: 8rem;
      flex: none;
      padding: 2.25rem 1rem 2rem;
    }
  }

  @media (max-width: 560px) {
    body {
      background-size: 20px 20px;
    }

    main {
      width: min(100% - 2.5rem, 54rem);
      padding-top: 3rem;
    }

    .content {
      line-height: 1.76;
    }

    .divider {
      margin-top: 3rem;
    }

    .packages {
      margin-top: 4.25rem;
    }

    .packages__title {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .packages__grid {
      margin-top: 2.25rem;
    }

    .package-card {
      min-height: 20rem;
      padding: 1.25rem;
      border-radius: 1.15rem;
    }

    .package-card__icon {
      min-height: 7rem;
      padding: 1.9rem 1rem 1.75rem;
    }

    .package-icon {
      width: 6.6rem;
    }

    .package-card__title {
      font-size: 1.35rem;
    }

    .package-card__description {
      font-size: 0.9rem;
    }
  }

  html[data-theme='dark'] {
    color: #ededeb;
    background-color: #181817;
  }

  html[data-theme='dark'] body {
    background-image: radial-gradient(circle, rgb(255 255 255 / 10%) 1px, transparent 1.2px);
  }

  html[data-theme='dark'] h1 {
    color: #f4f4f1;
  }

  html[data-theme='dark'] .content,
  html[data-theme='dark'] footer {
    color: #b8b8b2;
  }

  html[data-theme='dark'] .tag {
    color: #cdcdc7;
    background: #2d2d2a;
  }

  html[data-theme='dark'] a,
  html[data-theme='dark'] nav a {
    color: #efefeb;
    text-decoration-color: #686864;
  }

  html[data-theme='dark'] a:hover {
    color: #fff;
  }

  html[data-theme='dark'] .divider {
    background: #3c3c39;
  }

  html[data-theme='dark'] .packages__eyebrow,
  html[data-theme='dark'] .package-card__description {
    color: #a9a9a3;
  }

  html[data-theme='dark'] .packages__title,
  html[data-theme='dark'] .package-card__title {
    color: #f4f4f1;
  }

  html[data-theme='dark'] .package-card {
    border-color: #333330;
    color: #ededeb;
    background: #20201e;
  }

  html[data-theme='dark'] a.package-card[href]:hover {
    border-color: #4a4a46;
    background: #252522;
    box-shadow: 0 12px 30px rgb(0 0 0 / 20%);
  }

  html[data-theme='dark'] .package-card__step {
    border-color: rgb(255 255 255 / 4%);
    color: #cacac4;
    background: #2b2b28;
    box-shadow: none;
  }

  html[data-theme='dark'] .package-card__icon {
    --pixel-magenta: #ff65df;
    --pixel-orange: #ff7a4d;
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    :root,
    body,
    .site-nav__inner,
    .package-card {
      transition: none;
    }
  }
</style>
