---
import { author, hero, site } from '@/config.json'
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="author" content={author.name} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.url} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href={site.favicon} />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
    <title>{site.title}</title>
  </head>
  <body>
    <main>
      <img
        class="avatar"
        src={author.avatar}
        alt={`${author.name} 的头像`}
        width="112"
        height="112"
      />
      <h1>{hero.name}</h1>
      <p>{hero.bio}</p>
      <nav aria-label="主要入口">
        <a href="/projects">项目</a>
        <a class="primary" href="/blog">博客</a>
      </nav>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    background: #fafafa;
    color: #18181b;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
  }

  main {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .avatar {
    width: 7rem;
    height: 7rem;
    border: 1px solid #e4e4e7;
    border-radius: 999px;
    object-fit: cover;
  }

  h1 {
    margin: 2rem 0 0;
    font-size: clamp(2.25rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0.9rem 0 0;
    color: #71717a;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  a {
    min-width: 4rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid #d4d4d8;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  a:hover {
    border-color: #52525b;
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 3px;
  }

  a.primary {
    border-color: #18181b;
    background: #18181b;
    color: #fff;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      background: #111113;
      color: #fafafa;
    }

    .avatar,
    a {
      border-color: #3f3f46;
    }

    p {
      color: #a1a1aa;
    }

    a:hover {
      border-color: #a1a1aa;
    }

    a.primary {
      border-color: #fafafa;
      background: #fafafa;
      color: #18181b;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
