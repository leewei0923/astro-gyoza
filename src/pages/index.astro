---
import { author, hero, site } from '@/config.json'

const [github, x] = hero.socials
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="author" content={author.name} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.url} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href={site.favicon} />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
    <title>{site.title}</title>
  </head>
  <body>
    <header class="site-nav" data-site-nav>
      <div class="site-nav__inner">
        <a class="wordmark" href="/" aria-label="LEEWEI0923 首页">
          <span class="wordmark__text">LEEWEI0923</span>
          <span class="wordmark__dot" aria-hidden="true"></span>
        </a>
        <nav class="site-nav__menu" aria-label="主导航">
          <a class="site-nav__link is-active" href="/" aria-current="page">Home</a>
          <a class="site-nav__link" href="/blog">Blog</a>
          <a class="site-nav__link" href="/projects">Projects</a>
        </nav>
        <span class="site-nav__spacer" aria-hidden="true"></span>
      </div>
    </header>

    <main>
      <article aria-labelledby="intro-title" data-language-content>
        <h1 id="intro-title">{hero.name}</h1>

        <div class="content">
          <p class="lead">
            <span data-copy="zh">你好，我是 {hero.name}，一名独立开发者与 AI 创业者。</span>
            <span data-copy="en"
              >Hi, I'm {hero.name}, an independent developer and AI entrepreneur.</span
            >
          </p>

          <div class="now" data-now aria-label="目前正在进行的事情">
            <p>
              <span data-copy="zh">正在做 <span class="tag">拾记</span></span>
              <span data-copy="en">Currently building <span class="tag">Shiji</span></span>
            </p>
            <p>
              <span data-copy="zh">一个只属于你的记录系统。</span>
              <span data-copy="en">A personal system for capturing what matters to you.</span>
            </p>
          </div>

          <p>
            <span data-copy="zh">
              我也在开发 Flutter
              插件，把日常开发中反复遇到的小问题整理成更轻量、好用的工具，希望能让构建跨平台应用的过程更顺手一些。
            </span>
            <span data-copy="en">
              I also build Flutter plugins, turning recurring problems from day-to-day development
              into lightweight, practical tools that make building cross-platform apps feel a little
              smoother.
            </span>
          </p>

          <p>
            <span data-copy="zh">
              我喜欢把零散的想法做成真正能用的产品，从设计界面到完成开发，让想法落地是一件很有意思的事情。你可以在这里查看我的<a
                href="/projects">项目列表</a
              >。
            </span>
            <span data-copy="en">
              I enjoy turning scattered ideas into products people can actually use, from shaping
              the interface to shipping the final experience. You can explore my <a href="/projects"
                >project list</a
              > here.
            </span>
          </p>

          <p>
            <span data-copy="zh">
              我也会写一些关于产品、技术和生活的文字。偶尔记录灵光乍现，也收藏那些仍在发生的日常。你可以从<a
                href="/blog">博客</a
              >开始阅读。
            </span>
            <span data-copy="en">
              I also write about products, technology, and life—capturing passing ideas and the
              everyday moments still unfolding. You can start with my <a href="/blog">blog</a>.
            </span>
          </p>
        </div>

        <div class="divider" aria-hidden="true"></div>

        <footer>
          <p>
            <span data-copy="zh">在其他地方找到我</span>
            <span data-copy="en">Find me elsewhere</span>
          </p>
          <nav data-socials aria-label="社交媒体">
            {
              github && (
                <a href={github.url} rel="me noreferrer">
                  GitHub
                </a>
              )
            }
            {
              x && (
                <a href={x.url} rel="me noreferrer">
                  X / Twitter
                </a>
              )
            }
          </nav>
        </footer>
      </article>
    </main>

    <script is:inline>
      const siteNav = document.querySelector('[data-site-nav]')
      const updateNav = () => {
        siteNav?.toggleAttribute('data-scrolled', window.scrollY > 16)
      }

      let isFramePending = false
      const handleScroll = () => {
        if (isFramePending) return
        isFramePending = true
        requestAnimationFrame(() => {
          isFramePending = false
          updateNav()
        })
      }

      updateNav()
      window.addEventListener('scroll', handleScroll, { passive: true })
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-bold.woff') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    font-family: 'Atkinson', 'PingFang SC', 'Microsoft YaHei', ui-sans-serif, system-ui, sans-serif;
    color: #242424;
    background-color: #fbfbfa;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    background-image: radial-gradient(circle, rgb(35 35 35 / 11%) 1px, transparent 1.2px);
    background-size: 24px 24px;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  main {
    position: relative;
    width: min(100% - 3rem, 54rem);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) 0 4rem;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100% - 2.5rem, 1100px);
    min-height: 64px;
    margin: 0 auto;
    border-bottom: 1px solid transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-nav[data-scrolled] .site-nav__inner {
    border-bottom-color: rgb(35 35 35 / 10%);
    background-color: rgb(251 251 250 / 78%);
    backdrop-filter: blur(12px) saturate(150%);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    justify-self: start;
    color: #111;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: #111;
    text-decoration: none;
  }

  .wordmark__dot {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.06em;
    border-radius: 50%;
    background: #f55555;
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    column-gap: 2rem;
    justify-self: center;
  }

  .site-nav__link {
    position: relative;
    padding-bottom: 2px;
    color: #5d5d5d;
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .site-nav__link:hover {
    color: #111;
    text-decoration: none;
  }

  .site-nav__link.is-active {
    color: #111;
  }

  .site-nav__link.is-active::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: #111;
    content: '';
  }

  .site-nav__spacer {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .site-nav__inner {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
      padding: 0.75rem 0 0.7rem;
    }

    .site-nav__spacer {
      display: none;
    }

    .wordmark {
      justify-self: start;
      font-size: 0.95rem;
    }

    .site-nav__menu {
      justify-self: center;
      column-gap: 1.25rem;
    }
  }

  [data-copy='en'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='zh'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='en'] {
    display: inline;
  }

  article {
    width: 100%;
  }

  h1 {
    margin: 0;
    color: #111;
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .content {
    margin-top: clamp(3rem, 7vw, 4.25rem);
    color: #5d5d5d;
    font-size: clamp(1.2rem, 2.8vw, 1.45rem);
    line-height: 1.82;
  }

  html[data-lang='zh'] .content {
    font-size: clamp(1.12rem, 2.6vw, 1.34rem);
    line-height: 1.78;
  }

  .content p {
    margin: 0 0 1.55rem;
  }

  .content .lead {
    margin-bottom: 2rem;
  }

  .now {
    margin-bottom: 2.25rem;
  }

  .now p {
    margin: 0.15rem 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    margin-left: 0.25rem;
    padding: 0.05em 0.45em;
    border-radius: 0.35rem;
    color: #666;
    background: #ededeb;
    font-size: 0.92em;
  }

  a {
    color: #171717;
    text-decoration-color: #a9a9a6;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  a:hover {
    color: #000;
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 2px solid #3467d6;
    outline-offset: 4px;
  }

  .divider {
    width: 4rem;
    height: 1px;
    margin: 3.75rem auto 2.75rem;
    background: #d9d9d6;
  }

  footer {
    color: #5d5d5d;
    font-size: 1.18rem;
  }

  html[data-lang='zh'] footer {
    font-size: 1.1rem;
  }

  footer > p {
    margin: 0 0 1rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
  }

  nav a {
    color: #262626;
  }

  @media (max-width: 560px) {
    body {
      background-size: 20px 20px;
    }

    main {
      width: min(100% - 2.5rem, 54rem);
      padding-top: 3rem;
    }

    .content {
      line-height: 1.76;
    }

    .divider {
      margin-top: 3rem;
    }
  }

  html[data-theme='dark'] {
    color: #ededeb;
    background-color: #181817;
  }

  html[data-theme='dark'] body {
    background-image: radial-gradient(circle, rgb(255 255 255 / 10%) 1px, transparent 1.2px);
  }

  html[data-theme='dark'] h1 {
    color: #f4f4f1;
  }

  html[data-theme='dark'] .content,
  html[data-theme='dark'] footer {
    color: #b8b8b2;
  }

  html[data-theme='dark'] .tag {
    color: #cdcdc7;
    background: #2d2d2a;
  }

  html[data-theme='dark'] a,
  html[data-theme='dark'] nav a {
    color: #efefeb;
    text-decoration-color: #686864;
  }

  html[data-theme='dark'] a:hover {
    color: #fff;
  }

  html[data-theme='dark'] .divider {
    background: #3c3c39;
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    :root,
    body,
    .site-nav__inner {
      transition: none;
    }
  }
</style>
