---
import { author, flutterPackages, hero, site } from '@/config.json'

const [github, x] = hero.socials
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="author" content={author.name} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.url} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href={site.favicon} />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
    <title>{site.title}</title>
  </head>
  <body>
    <header class="site-nav" data-site-nav>
      <div class="site-nav__inner">
        <a class="wordmark" href="/" aria-label="LEEWEI0923 首页">
          <span class="wordmark__text">LEEWEI0923</span>
          <span class="wordmark__dot" aria-hidden="true"></span>
        </a>
        <nav class="site-nav__menu" aria-label="主导航">
          <a class="site-nav__link is-active" href="/" aria-current="page">Home</a>
          <a class="site-nav__link" href="/blog">Blog</a>
          <a class="site-nav__link" href="/projects">Projects</a>
        </nav>
        <span class="site-nav__spacer" aria-hidden="true"></span>
      </div>
    </header>

    <main>
      <article data-language-content>
        <section class="hero" aria-labelledby="intro-title">
          <ul class="hero__socials">
            {
              hero.socials.map((social) => (
                <li class="hero__social-item">
                  <a
                    class="hero__social"
                    href={social.url}
                    target="_blank"
                    rel="me noopener noreferrer"
                    title={social.name}
                  >
                    <span class="sr-only">{social.name}</span>
                    {social.name.toLowerCase() === 'github' && (
                      <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6a4.7 4.7 0 0 1 1.2-3.2 4.4 4.4 0 0 1 .1-3.2s1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2a4.4 4.4 0 0 1 .1 3.2 4.7 4.7 0 0 1 1.2 3.2c0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                      </svg>
                    )}
                    {(social.name.toLowerCase() === 'x' ||
                      social.name.toLowerCase() === 'twitter') && (
                      <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.5h2L6.5 3.2h-2.2l13.3 17.5Z" />
                      </svg>
                    )}
                    {!['github', 'x', 'twitter'].includes(social.name.toLowerCase()) && (
                      <svg
                        class="hero__icon hero__icon--outline"
                        viewBox="0 0 24 24"
                        stroke-width="1.7"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="9.4" />
                        <path d="M3.4 12h17.2M12 2.6c2.6 2.6 3.9 5.9 3.9 9.4s-1.3 6.8-3.9 9.4c-2.6-2.6-3.9-5.9-3.9-9.4S9.4 5.2 12 2.6Z" />
                      </svg>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>

          <h1 class="hero__title" id="intro-title">
            <span class="hero__title-lead">{hero.headline.lead}</span>{' '}<span
              class="hero__title-accent">{hero.headline.accent}</span
            >
          </h1>

          <p class="hero__subtitle">{hero.subheadline}</p>

          <div class="hero__actions">
            {
              hero.actions.map((action) => (
                <a class={`button button--${action.variant}`} href={action.href}>
                  {action.icon === 'phone' && (
                    <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.5 0 1 .4 1 1V20c0 .6-.5 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.5 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.3 1l-2.2 2.2Z" />
                    </svg>
                  )}
                  {action.icon === 'dot' && <span class="button__dot" aria-hidden="true" />}
                  <span>{action.label}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="packages" aria-labelledby="packages-title">
          <header class="packages__header">
            <p class="packages__eyebrow">{flutterPackages.eyebrow}</p>
            <h2 id="packages-title">{flutterPackages.title}</h2>
          </header>

          <ul class="packages__grid">
            {
              flutterPackages.items.map((item) => (
                <li class="package-item">
                  <a
                    class="package-card"
                    href={item.link || undefined}
                    target={item.link ? '_blank' : undefined}
                    rel={item.link ? 'noopener noreferrer external' : undefined}
                  >
                    <span class="package-card__step">STEP {item.step}</span>

                    <span class="package-card__icon" aria-hidden="true">
                      {item.icon === 'display' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 144 104"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--magenta"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M30 28h78v42H30z" />
                            <path d="M38 82h62" />
                            <path d="M52 82v-7h34v7" />
                            <path d="M45 18l13 10M99 18l-13 10" />
                          </g>
                          <g class="pixel pixel--magenta">
                            <path d="M46 40h30v7H46z" opacity=".28" />
                            <path d="M116 36h7v7h-7zM116 49h7v7h-7zM116 62h7v7h-7zM102 62h7v7h-7z" />
                          </g>
                        </svg>
                      )}

                      {item.icon === 'workflow' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 150 118"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--orange"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M22 20h34v8h8v28h-8v8H22v-8h-8V28h8z" />
                            <path d="M64 42h16V28h8" />
                            <path d="M64 54h16v32h8" />
                            <path d="M92 20h34v8h8v28h-8v8H92v-8h-8V28h8z" />
                            <path d="M92 72h34v8h8v24h-8v8H92v-8h-8V80h8z" />
                          </g>
                        </svg>
                      )}

                      {item.icon === 'notes' && (
                        <svg
                          class="package-icon"
                          viewBox="0 0 150 112"
                          role="presentation"
                          focusable="false"
                        >
                          <g
                            class="pixel pixel--magenta"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M20 38h58v42H40l-12 12V80H20z" />
                            <path d="M34 52h28M34 64h20" />
                          </g>
                          <g
                            class="pixel pixel--orange"
                            fill="none"
                            stroke-width="6"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                          >
                            <path d="M70 22h56v40H98l-12 12V62H70z" />
                            <path d="M84 36h28M84 48h20" />
                            <path d="M112 10h18v8h-8v8h-8v-8h-8v-8z" fill="currentColor" />
                          </g>
                        </svg>
                      )}
                    </span>

                    <div class="package-card__body">
                      <h3 class="package-card__title">{item.title}</h3>
                      <p class="package-card__description">{item.description}</p>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="divider" aria-hidden="true"></div>

        <footer>
          <p>
            <span data-copy="zh">在其他地方找到我</span>
            <span data-copy="en">Find me elsewhere</span>
          </p>
          <nav data-socials aria-label="社交媒体">
            {
              github && (
                <a href={github.url} rel="me noreferrer">
                  GitHub
                </a>
              )
            }
            {
              x && (
                <a href={x.url} rel="me noreferrer">
                  X / Twitter
                </a>
              )
            }
          </nav>
        </footer>
      </article>
    </main>

    <script is:inline>
      const siteNav = document.querySelector('[data-site-nav]')
      const updateNav = () => {
        siteNav?.toggleAttribute('data-scrolled', window.scrollY > 16)
      }

      let isFramePending = false
      const handleScroll = () => {
        if (isFramePending) return
        isFramePending = true
        requestAnimationFrame(() => {
          isFramePending = false
          updateNav()
        })
      }

      updateNav()
      window.addEventListener('scroll', handleScroll, { passive: true })
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Atkinson';
    src: url('/fonts/atkinson-bold.woff') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    font-family: 'Atkinson', 'PingFang SC', 'Microsoft YaHei', ui-sans-serif, system-ui, sans-serif;
    color: #242424;
    background-color: #fbfbfa;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    background-image: radial-gradient(circle, rgb(35 35 35 / 11%) 1px, transparent 1.2px);
    background-size: 24px 24px;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  main {
    position: relative;
    width: min(100% - 3rem, 54rem);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) 0 4rem;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100% - 2.5rem, 1100px);
    min-height: 64px;
    margin: 0 auto;
    border-bottom: 1px solid transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-nav[data-scrolled] .site-nav__inner {
    border-bottom-color: rgb(35 35 35 / 10%);
    background-color: rgb(251 251 250 / 78%);
    backdrop-filter: blur(12px) saturate(150%);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    justify-self: start;
    color: #111;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: #111;
    text-decoration: none;
  }

  .wordmark__dot {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.06em;
    border-radius: 50%;
    background: #f55555;
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    column-gap: 2rem;
    justify-self: center;
  }

  .site-nav__link {
    position: relative;
    padding-bottom: 2px;
    color: #5d5d5d;
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .site-nav__link:hover {
    color: #111;
    text-decoration: none;
  }

  .site-nav__link.is-active {
    color: #111;
  }

  .site-nav__link.is-active::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: #111;
    content: '';
  }

  .site-nav__spacer {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .site-nav__inner {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
      padding: 0.75rem 0 0.7rem;
    }

    .site-nav__spacer {
      display: none;
    }

    .wordmark {
      justify-self: start;
      font-size: 0.95rem;
    }

    .site-nav__menu {
      justify-self: center;
      column-gap: 1.25rem;
    }
  }

  [data-copy='en'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='zh'] {
    display: none;
  }

  html[data-lang='en'] [data-copy='en'] {
    display: inline;
  }

  article {
    width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero {
    padding-top: clamp(0.75rem, 3vw, 2rem);
    text-align: center;
  }

  .hero__socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2.1rem, 6vw, 3.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__social {
    display: inline-flex;
    width: clamp(1.8rem, 3.4vw, 2.15rem);
    height: clamp(1.8rem, 3.4vw, 2.15rem);
    align-items: center;
    justify-content: center;
    color: #0d0d0d;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .hero__social:hover {
    color: #8a8a86;
    transform: translateY(-2px);
  }

  .hero__icon {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .hero__icon--outline {
    fill: none;
    stroke: currentColor;
  }

  .hero__title {
    margin: clamp(1.5rem, 3.6vw, 2.4rem) 0 0;
    color: #0b0b0b;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.35rem, 7.4vw, 4.9rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero__title-accent {
    color: #8b8b87;
  }

  .hero__subtitle {
    max-width: 33rem;
    margin: clamp(1.05rem, 2.6vw, 1.6rem) auto 0;
    color: #71716e;
    font-size: clamp(1rem, 2vw, 1.24rem);
    line-height: 1.62;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(0.8rem, 1.8vw, 1.15rem);
    margin-top: clamp(1.75rem, 3.6vw, 2.5rem);
  }

  .button {
    display: inline-flex;
    min-height: clamp(3.2rem, 6vw, 3.6rem);
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.9rem clamp(1.5rem, 3.4vw, 2.15rem);
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: clamp(0.98rem, 1.6vw, 1.06rem);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .button__icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .button__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .button--primary {
    border-color: #0b0b0b;
    color: #fff;
    background: #0b0b0b;
  }

  .button--primary:hover {
    border-color: #262626;
    color: #fff;
    background: #262626;
    box-shadow: 0 12px 26px rgb(20 20 18 / 18%);
    transform: translateY(-1px);
  }

  .button--ghost {
    border-color: #e3e3df;
    color: #131313;
    background: #fff;
  }

  .button--ghost:hover {
    border-color: #c9c9c4;
    color: #131313;
    background: #fbfbfa;
    transform: translateY(-1px);
  }

  a {
    color: #171717;
    text-decoration-color: #a9a9a6;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  a:hover {
    color: #000;
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 2px solid #3467d6;
    outline-offset: 4px;
  }

  .divider {
    width: 4rem;
    height: 1px;
    margin: 3.75rem auto 2.75rem;
    background: #d9d9d6;
  }

  footer {
    color: #5d5d5d;
    font-size: 1.18rem;
  }

  html[data-lang='zh'] footer {
    font-size: 1.1rem;
  }

  footer > p {
    margin: 0 0 1rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
  }

  nav a {
    color: #262626;
  }

  .packages {
    margin-top: clamp(4.75rem, 10vw, 7.5rem);
  }

  .packages__header {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .packages__eyebrow {
    margin: 0;
    color: #888884;
    font-size: 0.72rem;
    line-height: 1.2;
    letter-spacing: 0.14em;
  }

  .packages__title {
    margin: 0.85rem 0 0;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 6.4vw, 3.65rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.035em;
  }

  .packages__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .package-item {
    min-width: 0;
  }

  .package-card {
    display: flex;
    min-height: clamp(24rem, 37vw, 29rem);
    flex-direction: column;
    align-items: center;
    padding: clamp(1.35rem, 2.8vw, 2rem);
    border: 1px solid #ececea;
    border-radius: 1.4rem;
    color: #242424;
    background: #f7f7f6;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  a.package-card[href]:hover {
    border-color: #d6d6d2;
    background: #f4f4f2;
    box-shadow: 0 12px 30px rgb(20 20 18 / 7%);
    transform: translateY(-4px);
  }

  .package-card:focus-visible {
    outline: 2px solid #3467d6;
    outline-offset: 4px;
  }

  .package-card__step {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(35 35 35 / 3%);
    border-radius: 0.5rem;
    color: #666662;
    background: #fff;
    box-shadow: 0 1px 2px rgb(20 20 18 / 4%);
    font-size: 0.73rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .package-card__icon {
    --pixel-magenta: #f22bcf;
    --pixel-orange: #f4511e;
    display: grid;
    width: 100%;
    min-height: 9rem;
    flex: 1;
    place-items: center;
    padding: 2.75rem 1rem 2.5rem;
  }

  .package-icon {
    width: min(100%, 7.75rem);
    height: auto;
    overflow: visible;
  }

  .pixel--magenta {
    fill: var(--pixel-magenta);
    stroke: var(--pixel-magenta);
  }

  .pixel--orange {
    fill: var(--pixel-orange);
    stroke: var(--pixel-orange);
  }

  .package-card__body {
    display: block;
    margin-top: auto;
  }

  .package-card__title {
    margin: 0;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.35rem, 2.7vw, 1.72rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .package-card__description {
    max-width: 20rem;
    margin: 0.85rem auto 0;
    color: #777773;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .packages__grid {
      max-width: 32rem;
      grid-template-columns: 1fr;
      margin-inline: auto;
    }

    .package-card {
      min-height: 22rem;
    }

    .package-card__icon {
      min-height: 8rem;
