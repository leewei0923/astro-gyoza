---
import { GiscusComments } from './GiscusComments'
import { giscus } from '@/config.json'

interface Props {
  term: string
}

const { term } = Astro.props
const isConfigured = Boolean(giscus.repo && giscus.repoId && giscus.category && giscus.categoryId)
---

{
  isConfigured && (
    <div class="min-w-0">
      <GiscusComments {...giscus} term={term} client:only="react" />
    </div>
  )
}
